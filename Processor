import java.util.LinkedList;
import java.util.List;
import java.util.Stack;

public class Processor {
    private Memory mem;
    public List<String> output = new LinkedList<>();
    private Word32 PC = new Word32();
    private Word32 currentInstructionWord = new Word32();
    private Word16 instruction = new Word16();
    private Word32[] registers = new Word32[32];
    private ALU alu = new ALU();
    private Stack<Word32> callStack = new Stack<>();
    private boolean halted = false;

    private int opcode, destReg, srcReg, immediate;
    private boolean isImmediate;

    public Processor(Memory m) {
        this.mem = m;
        for(int i = 0; i < 32; i++) registers[i] = new Word32();
    }

    public void run() {
        int safety = 0;
        while(!halted && safety < 10000) {
            fetch();
            decode();
            execute();
            store();
            safety++;
        }
    }

    private void fetch() {
        int pcVal = TestConverter.toInt(PC);
        // Memory address is Word32-based. Each Word32 holds two 16-bit instructions.
        TestConverter.fromInt(pcVal / 2, mem.address);
        mem.read();
        mem.value.copy(currentInstructionWord);

        // Fetch top 16 bits for even PC, bottom 16 bits for odd PC
        if(pcVal % 2 == 0) currentInstructionWord.getTopHalf(instruction);
        else currentInstructionWord.getBottomHalf(instruction);

        // Increment PC so it points to the NEXT instruction for branches/calls
        updatePC(1);
    }

    private void decode() {
        Bit temp = new Bit(false);
        opcode = 0; destReg = 0; srcReg = 0; immediate = 0;

        // 1. Decode Opcode (Bits 0-4)
        for(int i = 0; i < 5; i++) {
            instruction.getBitN(i, temp);
            if(temp.getValue()) opcode += (1 << (4 - i));
        }

        // 2. Identify Format
        // Format 1: Call/Branch/Halt/Return/Syscall (11-bit Immediate)
        if(opcode == 0 || (opcode >= 8 && opcode <= 10) || (opcode >= 12 && opcode <= 17)) {
            isImmediate = true;
            for(int i = 5; i < 16; i++) {
                instruction.getBitN(i, temp);
                if(temp.getValue()) immediate += (1 << (15 - i));
            }
            if(immediate >= 1024) immediate -= 2048; // 11-bit Sign Extension
        } else {
            // Format 2: 2R or 5-bit Immediate
            instruction.getBitN(5, temp);
            isImmediate = temp.getValue();

            for(int i = 6; i <= 10; i++) {
                instruction.getBitN(i, temp);
                if(temp.getValue()) srcReg += (1 << (10 - i));
            }
            for(int i = 11; i <= 15; i++) {
                instruction.getBitN(i, temp);
                if(temp.getValue()) destReg += (1 << (15 - i));
            }

            if(isImmediate) {
                immediate = srcReg; // 5-bit immediate is stored in srcReg bits
                if(immediate >= 16) immediate -= 32; // 5-bit Sign Extension
            }
        }

        // 3. Setup ALU Operands
        registers[destReg].copy(alu.op1);
        if (isImmediate) {
            Word32 immWord = new Word32();
            TestConverter.fromInt(immediate, immWord);
            immWord.copy(alu.op2);
        } else {
            registers[srcReg].copy(alu.op2);
        }

        // Pass instruction bits to ALU for flag processing
        for(int i = 0; i < 16; i++) {
            instruction.getBitN(i, temp);
            alu.instruction.setBitN(i, new Bit(temp.getValue()));
        }
    }

    private void execute() {
        if (opcode == 0) { halted = true; return; }
        // Arithmetic/Compare Opcodes
        if ((opcode >= 1 && opcode <= 7) || opcode == 11) {
            alu.doInstruction();
        }
    }

    private void store() {
        if(halted) return;
        System.out.println("PC=" + (TestConverter.toInt(PC)-1) +
                " op=" + opcode + " dest=" + destReg +
                " src=" + srcReg + " imm=" + immediate +
                " isImm=" + isImmediate);
        switch(opcode) {
            case 1: case 2: case 3: case 4: case 5: case 6: case 7:
                alu.result.copy(registers[destReg]);
                break;
            case 8: // Syscall
                if(immediate == 0) printReg();
                else if(immediate == 1) printMem();
                break;
            case 18: // Load
                setMemAddress();
                mem.read();
                mem.value.copy(registers[destReg]);
                break;
            case 19: // Store
                setMemAddress();
                if (isImmediate) {
                    // FIX 1: store the immediate value, not the register
                    Word32 imm = new Word32();
                    TestConverter.fromInt(immediate, imm);
                    imm.copy(mem.value);
                } else {
                    registers[srcReg].copy(mem.value);
                }
                mem.write();
                break;
            case 20: // Copy
                if (isImmediate) TestConverter.fromInt(immediate, registers[destReg]);
                else registers[srcReg].copy(registers[destReg]);
                break;
            case 9: // Call
                Word32 ret = new Word32();
                PC.copy(ret);
                callStack.push(ret);
                jumpWordRelative(immediate); // FIX 2
                break;
            case 10: // Return
                if(!callStack.isEmpty()) callStack.pop().copy(PC);
                break;
            case 12: case 13: case 14: case 15: case 16: case 17:
                if(shouldBranch()) jumpWordRelative(immediate); // FIX 2
                break;
        }
    }

    private void setMemAddress() {
        if (isImmediate) {
            if (opcode == 19) {
                // store: address is just destReg, immediate is the value
                registers[destReg].copy(mem.address);
            } else {
                // load: address is imm + destReg
                Word32 imm = new Word32();
                TestConverter.fromInt(immediate, imm);
                Adder.add(imm, registers[destReg], mem.address);
            }
        } else {
            registers[destReg].copy(mem.address);
        }
    }

    private void updatePC(int offset) {
        Word32 offWord = new Word32();
        TestConverter.fromInt(offset, offWord);
        Word32 nextPC = new Word32();
        Adder.add(PC, offWord, nextPC);
        nextPC.copy(PC);
    }

    private boolean shouldBranch() {
        boolean less = alu.less.getValue();
        boolean equal = alu.equal.getValue();
        switch(opcode) {
            case 12: return less || equal;
            case 13: return less;
            case 14: return !less;
            case 15: return !less && !equal;
            case 16: return equal;
            case 17: return !equal;
            default: return false;
        }
    }

    private void printReg() {
        for (int i = 0; i < 32; i++) {
            output.add("r" + i + ":" + registers[i].toString());
        }
    }

    private void printMem() {
        for (int i = 0; i < 400; i++) {
            Word32 addr = new Word32();
            TestConverter.fromInt(i, addr);
            addr.copy(mem.address);
            mem.read();
            output.add(i + ":" + mem.value.toString() + "(" + TestConverter.toInt(mem.value) + ")");
        }
    }

    private void jumpWordRelative(int immediate) {
        int fetchedInstr = TestConverter.toInt(PC) - 1;
        int currentWord = fetchedInstr / 2;
        int targetWord = currentWord + immediate;
        int targetInstr = targetWord * 2;
        int offset = targetInstr - TestConverter.toInt(PC);
        updatePC(offset);
    }
}
