public class ALU {

    public Word16 instruction = new Word16();
    public Word32 op1 = new Word32();
    public Word32 op2 = new Word32();
    public Word32 result = new Word32();
    public Bit less = new Bit(false);
    public Bit equal = new Bit(false);

    public void doInstruction() {

        switch(getOpcode()){//SIA 2026 order

            case 1:
                Adder.add(op1, op2, result);
                break;

            case 2:
                op1.and(op2, result);
                break;

            case 3:
                Multiplier.multiply(op1, op2, result);
                break;

            case 4:
                int shiftLeft = getShiftAmount(op2);
                Shifter.LeftShift(op1, shiftLeft, result);
                break;

            case 5:
                Word32 neg = new Word32();
                op2.not(neg);

                Word32 one = new Word32();
                TestConverter.fromInt(1, one);

                Adder.add(neg, one, neg);
                Adder.add(op1, neg, result);
                break;

            case 6:
                op1.or(op2, result);
                break;

            case 7:
                int shiftRight = getShiftAmount(op2);
                Shifter.RightShift(op1, shiftRight, result);
                break;

            case 11:
                compare();
                break;
        }
    }

    private int getOpcode() {

        int opcode = 0;
        Bit bit = new Bit(false);
        int[] values = {16, 8, 4, 2, 1};

        for(int i = 0; i < 5; i++){
            instruction.getBitN(i, bit);//Reads i bits in instruction, stores true/false value in bit
            if(bit.getValue()){
                opcode += values[i];//if the bit is 1 add the value of i
            }
        }
        return opcode;
    }

    private int getShiftAmount(Word32 word){

        int value = 0;
        Bit bit = new Bit(false);
        int[] values = {16, 8, 4, 2, 1};
        int index = 0;

        for(int i = 27; i < 32; i++){
            word.getBitN(i, bit);
            if(bit.getValue()){
                value += values[index];
            }
            index++;
        }
        return value;
    }

    private void compare(){

        equal.assign(false);
        less.assign(false);

        Word32 difference = new Word32();
        Word32 negative = new Word32();

        op2.not(negative);

        Word32 one = new Word32();
        TestConverter.fromInt(1, one);

        Adder.add(negative, one, negative);
        Adder.add(op1, negative, difference);

        boolean isZero = true;
        Bit temp = new Bit(false);

        for(int i = 0; i < 32; i++){
            difference.getBitN(i, temp);//reads bit i from difference
            if(temp.getValue()){//if a 1 is found result isn't 0
                isZero = false;
                break;
            }
        }
        if(isZero){
            equal.assign(true);
        }
        Bit sign = new Bit(false);
        difference.getBitN(0, sign);
        if(sign.getValue()){//if the result is negative set the less flag
            less.assign(true);
        }
    }
}
