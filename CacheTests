import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class CacheTest {

    // ---------------------------------------------------------------
    // Test 1: Sum 1..100 using only registers (no memory access)
    //
    // Immediate limit is 5-bit signed: -16 to 15.
    // So 100 must be built: copy 10 r2; multiply 10 r2 -> r2=100
    //
    // Instruction index / word layout:
    //   0(w0t): copy 0 r0        accumulator=0
    //   1(w0b): copy 1 r1        counter=1
    //   2(w1t): copy 10 r2
    //   3(w1b): multiply 10 r2   r2=100
    //   4(w2t): copy 1 r3        step=1
    //   5(w2b): add 0 r0         pad (nop)
    //   6(w3t): add r1 r0        <- LOOP START (word 3, even ✓)
    //   7(w3b): add r3 r1        counter++
    //   8(w4t): compare r2 r1    flags: r1-r2
    //   9(w4b): blt -1           B=9,word=4,target=(4-1)*2=6 -> PC=6 ✓
    //  10(w5t): syscall 0
    //  11(w5b): halt
    // ---------------------------------------------------------------
    @Test
    public void testSumLoop() {
        String[] program = {
                "copy 0 r0",        //  0: accumulator = 0
                "copy 1 r1",        //  1: counter = 1
                "copy 10 r2",       //  2:
                "multiply 10 r2",   //  3: r2 = 100
                "copy 1 r3",        //  4: step = 1
                "add 0 r0",         //  5: pad (nop)
                // LOOP START word 3, instr 6
                "add r1 r0",        //  6: r0 += r1
                "add r3 r1",        //  7: r1++
                "compare r2 r1",    //  8: flags: r1 - r2
                "blt -1",           //  9: if r1 < r2 -> word3 (instr6) ✓
                "syscall 0",        // 10
                "halt"              // 11
        };
        Processor p = runProgram(program);

        Word32 r0 = new Word32();
        p.registers[0].copy(r0);
        assertEquals(5050, TestConverter.toInt(r0), "Sum 1-100 loop: r0 should be 5050");
        System.out.println("testSumLoop clock cycles: " + p.currentClockCycle);
    }

    // ---------------------------------------------------------------
    // Test 2: Store 1-100 in memory addresses 200-299, then load and sum
    //
    // Constants built:
    //   r5=100: copy 10 r5; multiply 10 r5
    //   r1=200: copy r5 r1; leftshift 1 r1
    //   r3=300: copy r5 r3; add r1 r3
    //
    // load semantics: "load 0 rX" -> rX = mem[rX + 0]  (immediate offset)
    // store semantics: "store rSrc rDest" -> mem[rDest] = rSrc
    //
    // Instruction layout:
    //   0(w0t): copy 0 r4         accumulator=0
    //   1(w0b): copy 10 r5
    //   2(w1t): multiply 10 r5    r5=100
    //   3(w1b): copy 1 r2         step=1
    //   4(w2t): copy r5 r1        r1=100
    //   5(w2b): leftshift 1 r1    r1=200
    //   6(w3t): copy r5 r3        r3=100
    //   7(w3b): add r1 r3         r3=300
    //   8(w4t): copy 1 r0         value=1
    //   9(w4b): add 0 r4          pad
    //  10(w5t): store r0 r1       <- FILL LOOP START (word 5 ✓)
    //  11(w5b): add r2 r0         value++
    //  12(w6t): add r2 r1         address++
    //  13(w6b): compare r3 r1     flags: r1-r3
    //  14(w7t): blt -2            B=14,word=7,target=(7-2)*2=10 -> PC=10 ✓
    //  15(w7b): copy r5 r1        rebuild r1=100
    //  16(w8t): leftshift 1 r1    r1=200 (reset address)
    //  17(w8b): add 0 r4          pad
    //  18(w9t): copy r1 r6        <- SUM LOOP START (word 9 ✓)
    //  19(w9b): load 0 r6         r6=mem[r6+0]
    //  20(w10t): add r6 r4        r4+=r6
    //  21(w10b): add r2 r1        address++
    //  22(w11t): compare r3 r1    flags: r1-r3
    //  23(w11b): blt -2           B=23,word=11,target=(11-2)*2=18 -> PC=18 ✓
    //  24(w12t): syscall 0
    //  25(w12b): halt
    // ---------------------------------------------------------------
    @Test
    public void testSumArray() {
        String[] program = {
                "copy 0 r4",        //  0: accumulator = 0
                "copy 10 r5",       //  1:
                "multiply 10 r5",   //  2: r5 = 100
                "copy 1 r2",        //  3: step = 1
                "copy r5 r1",       //  4: r1 = 100
                "leftshift 1 r1",   //  5: r1 = 200
                "copy r5 r3",       //  6: r3 = 100
                "add r1 r3",        //  7: r3 = 300
                "copy 1 r0",        //  8: value = 1
                "add 0 r4",         //  9: pad
                // FILL LOOP START word 5, instr 10
                "store r0 r1",      // 10: mem[r1] = value
                "add r2 r0",        // 11: value++
                "add r2 r1",        // 12: address++
                "compare r3 r1",    // 13: flags: r1 - r3
                "blt -2",           // 14: if r1 < r3 -> word5 (instr10) ✓
                // reset address for sum loop
                "copy r5 r1",       // 15: r1 = 100
                "leftshift 1 r1",   // 16: r1 = 200
                "add 0 r4",         // 17: pad
                // SUM LOOP START word 9, instr 18
                "copy r1 r6",       // 18: r6 = address
                "load 0 r6",        // 19: r6 = mem[r6]
                "add r6 r4",        // 20: r4 += r6
                "add r2 r1",        // 21: address++
                "compare r3 r1",    // 22: flags: r1 - r3
                "blt -2",           // 23: if r1 < r3 -> word9 (instr18) ✓
                "syscall 0",        // 24
                "halt"              // 25
        };
        Processor p = runProgram(program);

        Word32 r4 = new Word32();
        p.registers[4].copy(r4);
        assertEquals(5050, TestConverter.toInt(r4), "Sum array: r4 should be 5050");
        System.out.println("testSumArray clock cycles: " + p.currentClockCycle);
    }

    // ---------------------------------------------------------------
    // Test 3: Build linked list of 100 nodes, traverse and sum
    //
    // Node layout: [value, next_address] at addresses 200,202,...,398
    // Last node's next = 0 (null terminator)
    //
    // Constants built:
    //   r4=100: copy 10 r4; multiply 10 r4
    //   r0=200: copy r4 r0; leftshift 1 r0
    //
    // Instruction layout:
    //   0(w0t): copy 1 r2         step1=1
    //   1(w0b): copy 2 r3         step2=2
    //   2(w1t): copy 10 r4
    //   3(w1b): multiply 10 r4    r4=100
    //   4(w2t): copy 0 r5         null=0
    //   5(w2b): copy r4 r0        r0=100
    //   6(w3t): leftshift 1 r0    r0=200
    //   7(w3b): copy 1 r1         value=1
    //   8(w4t): store r1 r0       <- BUILD LOOP START (word 4 ✓)
    //   9(w4b): copy r0 r7        r7=r0
    //  10(w5t): add r2 r7         r7=r0+1 (next-ptr slot)
    //  11(w5b): copy r0 r6        r6=r0
    //  12(w6t): add r3 r6         r6=r0+2 (next node addr)
    //  13(w6b): store r6 r7       mem[r0+1]=next addr
    //  14(w7t): add r3 r0         r0+=2
    //  15(w7b): add r2 r1         r1++
    //  16(w8t): compare r4 r1     flags: r1-r4
    //  17(w8b): ble -4            B=17,word=8,target=(8-4)*2=8 -> PC=8 ✓
    //  18(w9t): store r5 r7       last node next=0
    //  19(w9b): copy r4 r8        r8=100
    //  20(w10t): leftshift 1 r8   r8=200 (head)
    //  21(w10b): copy 0 r9        accumulator=0
    //  22(w11t): copy r8 r10      <- TRAVERSE LOOP START (word 11 ✓)
    //  23(w11b): load 0 r8        r8=mem[r8]=node value
    //  24(w12t): add r8 r9        r9+=value
    //  25(w12b): add r2 r10       r10=next-ptr slot addr
    //  26(w13t): copy r10 r8      r8=r10
    //  27(w13b): load 0 r8        r8=mem[r10]=next addr
    //  28(w14t): compare r5 r8    flags: r8-0
    //  29(w14b): bne -3           B=29,word=14,target=(14-3)*2=22 -> PC=22 ✓
    //  30(w15t): syscall 0
    //  31(w15b): halt
    // ---------------------------------------------------------------
    @Test
    public void testSumLinkedList() {
        String[] program = {
                "copy 1 r2",        //  0: step1 = 1
                "copy 2 r3",        //  1: step2 = 2
                "copy 10 r4",       //  2:
                "multiply 10 r4",   //  3: r4 = 100
                "copy 0 r5",        //  4: null = 0
                "copy r4 r0",       //  5: r0 = 100
                "leftshift 1 r0",   //  6: r0 = 200 (start address)
                "copy 1 r1",        //  7: value = 1
                // BUILD LOOP START word 4, instr 8
                "store r1 r0",      //  8: mem[r0] = value
                "copy r0 r7",       //  9: r7 = r0
                "add r2 r7",        // 10: r7 = r0+1 (next-ptr slot)
                "copy r0 r6",       // 11: r6 = r0
                "add r3 r6",        // 12: r6 = r0+2 (next node addr)
                "store r6 r7",      // 13: mem[r0+1] = next addr
                "add r3 r0",        // 14: r0 += 2
                "add r2 r1",        // 15: r1++
                "compare r4 r1",    // 16: flags: r1 - r4
                "ble -4",           // 17: if r1 <= r4 -> word4 (instr8) ✓
                "store r5 r7",      // 18: mem[last next-ptr slot] = 0
                "copy r4 r8",       // 19: r8 = 100
                "leftshift 1 r8",   // 20: r8 = 200 (head pointer)
                "copy 0 r9",        // 21: accumulator = 0
                // TRAVERSE LOOP START word 11, instr 22
                "copy r8 r10",      // 22: r10 = current node addr
                "load 0 r8",        // 23: r8 = mem[r8] = node value
                "add r8 r9",        // 24: r9 += value
                "add r2 r10",       // 25: r10 = next-ptr slot addr
                "copy r10 r8",      // 26: r8 = r10
                "load 0 r8",        // 27: r8 = mem[r10] = next addr
                "compare r5 r8",    // 28: flags: r8 - 0
                "bne -3",           // 29: if r8 != 0 -> word11 (instr22) ✓
                "syscall 0",        // 30
                "halt"              // 31
        };
        Processor p = runProgram(program);

        Word32 r9 = new Word32();
        p.registers[9].copy(r9);
        assertEquals(5050, TestConverter.toInt(r9), "Sum linked list: r9 should be 5050");
        System.out.println("testSumLinkedList clock cycles: " + p.currentClockCycle);
    }

    private static Processor runProgram(String[] program) {
        String[] assembled = Assembler.assemble(program);
        String[] merged    = Assembler.finalOutput(assembled);
        Memory m           = new Memory();
        m.load(merged);
        Processor p        = new Processor(m);
        p.run();
        return p;
    }
}
