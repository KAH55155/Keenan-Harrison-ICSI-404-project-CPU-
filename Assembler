import java.util.HashMap;
import java.util.LinkedList;


public class Assembler {

    private static HashMap<String, Integer> opcodeMap = new HashMap<>();
    private static HashMap<String, Integer> registerMap = new HashMap<>();

    static {
        opcodeMap.put("halt", 0);
        opcodeMap.put("add", 1);
        opcodeMap.put("and", 2);
        opcodeMap.put("multiply", 3);
        opcodeMap.put("leftshift", 4);
        opcodeMap.put("subtract", 5);
        opcodeMap.put("or", 6);
        opcodeMap.put("rightshift", 7);
        opcodeMap.put("syscall", 8);
        opcodeMap.put("call", 9);
        opcodeMap.put("return", 10);
        opcodeMap.put("compare", 11);
        opcodeMap.put("ble", 12);
        opcodeMap.put("blt", 13);
        opcodeMap.put("bge", 14);
        opcodeMap.put("bgt", 15);
        opcodeMap.put("beq", 16);
        opcodeMap.put("bne", 17);
        opcodeMap.put("load", 18);
        opcodeMap.put("store", 19);
        opcodeMap.put("copy", 20);

        for (int i = 0; i < 32; i++) {
            registerMap.put("r" + i, i);
        }
    }

    public static String[] assemble(String[] input) {

        String[] output = new String[input.length];

        for (int i = 0; i < input.length; i++) {

            String line = input[i].toLowerCase().trim();
            String[] parts = line.split(" ");

            String op = parts[0];
            int opcode = opcodeMap.get(op);
            String opcodeBits = toBinary(opcode, 5);

            // ---- HALT ----
            if (op.equals("halt")) {
                output[i] = "0000000000000000";
                continue;
            }

            // ---- RETURN ---- (no args, special encoding)
            if (op.equals("return")) {
                output[i] = opcodeBits + "0" + "00000" + "00000";
                continue;
            }

            // ---- 1 ARG (syscall, call, branches) ----
            // ---- 1 ARG ----
            if (parts.length == 2) {

                int value = Integer.parseInt(parts[1]);

                // FULL IMMEDIATE instructions
                if (op.equals("syscall") || op.equals("call") ||
                        op.equals("ble") || op.equals("blt") ||
                        op.equals("bge") || op.equals("bgt") ||
                        op.equals("beq") || op.equals("bne")) {

                    output[i] =
                            opcodeBits +
                                    toBinarySigned(value, 11);

                } else {
                    // fallback (probably not used but safe)
                    output[i] =
                            opcodeBits +
                                    "1" +
                                    toBinarySigned(value, 5) +
                                    "00000";
                }

                continue;
            }
            // ---- 2 ARG ----
            boolean isImmediate = !parts[1].startsWith("r");

            if (!isImmediate) {
                // 2R
                int src = registerMap.get(parts[1]);
                int dest = registerMap.get(parts[2]);

                output[i] =
                        opcodeBits +
                                "0" +
                                toBinary(src, 5) +
                                toBinary(dest, 5);

            } else {
                // immediate
                int value = Integer.parseInt(parts[1]);
                int dest = registerMap.get(parts[2]);

                output[i] =
                        opcodeBits +
                                "1" +
                                toBinarySigned(value, 5) +
                                toBinary(dest, 5);
            }
        }

        return output;
    }

    public static String[] finalOutput(String[] input) {

        int size = (input.length + 1) / 2;
        String[] output = new String[size];

        int index = 0;

        for (int i = 0; i < input.length; i += 2) {

            String first = input[i];
            String second;

            if (i + 1 < input.length) {
                second = input[i + 1];
            } else {
                second = "0000000000000000";
            }

            output[index] = first + second;
            index++;
        }

        return output;
    }

    private static String toBinary(int value, int bits) {
        String binary = Integer.toBinaryString(value);

        while (binary.length() < bits) {
            binary = "0" + binary;
        }

        return binary;
    }

    private static String toBinarySigned(int value, int bits) {
        int mask = (1 << bits) - 1;
        int twos = value & mask;
        return toBinary(twos, bits);
    }
}
